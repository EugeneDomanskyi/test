generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Market {
  id                        Int      @id @default(autoincrement())
  cgId                      String 
  blockchain                String 
  type                      String 
  name                      String 
  address                   String 
  image                     String 
  banner                    String 
  currency                  String 
  description               String 
  tokenCount                String 
  discordUrl                String 
  externalUrl               String 
  twitterUrl                String 
  openseaVerificationStatus Boolean  @default(false)
  sampleImages              String 
  decimals                  String 
  symbol                    String 
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
}
